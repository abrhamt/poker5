# Database
poker.db
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets and local config
.env
.env.*
!.env.example

# Build artifacts. Anchored with a leading slash so they match the built
# binaries at the module root and not the cmd/poker-demo source directory.
/poker-server
/poker-demo
dist/

# Logs
*.log

# Archives and deploy bundles
*.tar.gz
*.tgz
*.zip

# scp/rsync mishaps — a stray "root@host" file is a copy that lost its colon
root@*

# Editor and OS noise
.DS_Store
*.swp
.idea/
.vscode/
